{
  "expo": {
    "name": "Dairy Farm",
    "slug": "dairy-farm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "zm.dairyfarm.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#24583A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "zm.dairyfarm.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dairy Farm uses your photos to add pictures of your animals and expense receipts.",
          "cameraPermission": "Dairy Farm uses the camera to photograph your animals and expense receipts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Dairy Farm uses Face ID to unlock the app when you turn on app lock."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF6",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E1511"
          },
          "ios": {
            "image": "./assets/splash-spots.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover",
            "backgroundColor": "#FBFAF6",
            "dark": {
              "image": "./assets/splash-spots-dark.png",
              "backgroundColor": "#0E1511"
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#24583A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ]
    ],
    "scheme": "dairyfarm",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7826d0e8-b989-4d0d-a40a-6e2e5d4c6c68"
      }
    },
    "owner": "jmumba"
  }
}
