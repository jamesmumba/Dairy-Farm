# Public values only. Server secrets never go in the app.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The API Edge Function: https://<project-ref>.supabase.co/functions/v1/api
# For a local API (npm run dev) on a real phone, use your computer's LAN address, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://<project-ref>.supabase.co/functions/v1/api
