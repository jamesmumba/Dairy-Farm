{
  "name": "@dairy/api",
  "version": "1.0.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "erase-account": "tsx scripts/erase-account.ts",
    "integrity": "tsx scripts/integrity.ts",
    "test:postgres": "vitest run -c vitest.postgres.config.ts",
    "build:edge": "node scripts/build-edge.mjs",
    "pretest": "node scripts/build-edge.mjs"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "private": true
}
